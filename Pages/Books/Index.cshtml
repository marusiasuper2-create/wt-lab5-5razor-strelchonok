@page
@model wt_lab5_5razor_strelchonok.Pages.Books.IndexModel

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">📚 Каталог книг</h1>
            <p class="text-muted">Всего книг в библиотеке: @Model.Books.Count</p>
        </div>
        <a asp-page="/Books/Create" class="btn btn-primary">➕ Добавить книгу</a>
    </div>

    <div class="row g-4">
        @foreach (var book in Model.Books)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm rounded-4">
                    <div class="card-body">
                        <span class="badge bg-secondary mb-2">ID: @book.Id</span>
                        <h5 class="card-title">@book.Title</h5>
                        <p class="text-muted mb-1">@book.Author</p>
                        <p class="mb-2">
                            @book.Genre • @book.Year г. • @book.Pages стр.
                        </p>
                        @if (book.IsAvailable)
                        {
                            <span class="badge bg-success">В наличии</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Нет в наличии</span>
                        }
                        <div class="mt-3">
                            <a asp-page="/Books/Details" asp-route-id="@book.Id"
                               class="btn btn-outline-primary btn-sm">Подробнее</a>
                            <a asp-page="/Books/Edit" asp-route-id="@book.Id"
                               class="btn btn-outline-warning btn-sm">Редактировать</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>